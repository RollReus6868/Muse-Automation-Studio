{
  "name": "muse-automation-studio",
  "productName": "Muse Automation Studio",
  "version": "1.5.0",
  "description": "Tool desktop tu dong tao anh va video tren muse.ai - chay nhieu luong, nhieu tai khoan",
  "main": "main.js",
  "author": "RollReus6868",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js && node tests/cap-nhat-test.js",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --arm64 --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rollreus.musestudio",
    "productName": "Muse Automation Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "icons/**/*",
      "package.json"
    ],
    "afterPack": "tools/ky-mac.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "artifactName": "MuseAutomationStudio-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muse Automation Studio",
      "deleteAppDataOnUninstall": false,
      "unicode": true
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MuseAutomationStudio-${version}-mac-${arch}.${ext}"
    },
    "compression": "maximum",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RollReus6868/Muse-Automation-Studio.git"
  }
}
